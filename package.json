{
  "name": "rifa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "server:node": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "mercadopago": "^3.3.0",
    "three": "^0.185.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}