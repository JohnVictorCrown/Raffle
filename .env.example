# ============================================================
# Golden Lion Rifa - environment variables (copy this file to
# `.env` and fill in your values. `.env` is gitignored.)
#
#   cp .env.example .env
# ============================================================

# Mercado Pago API credentials (https://www.mercadopago.com/developers)
# Use your PRODUCTION access token (starts with APP_USR-) for real payments,
# or a TEST token (starts with TEST-) to only simulate payments.
MP_ACCESS_TOKEN=

# Optional: platform access token / public key. Not required for backend PIX
# via the Orders API, only for frontend card tokenization (MercadoPago.js).
MP_PUBLIC_KEY=

# Public URL that Mercado Pago can reach to notify payment status changes.
# Must be HTTPS and reachable from the internet in production.
# e.g. https://seu-dominio.com/api/webhooks/mercadopago
MP_NOTIFICATION_URL=http://localhost:3001/api/webhooks/mercadopago

# Optional: if you want to verify incoming webhook signatures, create a webhook
# in your MP dashboard and paste its secret here.
MP_WEBHOOK_SECRET=

# Optional: max allowed clock drift (in seconds) for webhook signature timestamps.
# Defaults to 300 (5 minutes). Lower values are stricter against replay attacks.
MP_WEBHOOK_TOLERANCE=300

# --- Server ---
# Port the Bun API server listens on (the frontend proxies /api to this).
PORT=3001

# Allowed origin for API calls (CORS). Use "*" to allow any origin in dev.
CORS_ORIGIN=*

# --- Raffle / Admin ---
# Password an admin must submit on /admin to create the raffle (env-protected).
ADMIN_PASSWORD=change-me

# Public host used to build the prize-claim link sent to the winner by email.
# e.g. yourdomain.com (no scheme/protocol here).
PUBLIC_HOST=localhost:3000

# Optional: winner email delivery (currently logged to console in dev).
# Real delivery uses Gmail SMTP with an app password:
#   EMAIL_USER=stellar.505org@gmail.com
#   EMAIL_PASS=<your Gmail app password>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Stellar Raffles <stellar.505org@gmail.com>